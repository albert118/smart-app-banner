{
    "name": "@easy-smart-app-banner/vue-demo",
    "version": "2.0.0",
    "description": "A Vue demo for smart-app-banner",
    "main": "main.ts",
    "scripts": {
        "dev": "vite",
        "setup": "npm i --install-links && npm run type-check",
        "build": "npm run build-only && npm run type-check",
        "preview": "vite preview",
        "build-only": "vite build",
        "type-check": "vue-tsc --project tsconfig.app.json --composite false --noEmit",
        "test": "vitest --watch false",
        "format": "prettier --write src/",
        "clean": "rm -rf ./dist"
    },
    "author": "Albert Ferguson <albertferguson118@gmail.com>",
    "license": "MIT",
    "bugs": {
        "url": "https://github.com/albert118/smart-app-banner/issues"
    },
    "private": false,
    "dependencies": {
        "@easy-smart-app-banner/vue-plugin": "^2.1.1",
        "@vueuse/core": "^13.0.0",
        "js-logger": "^1.6.1",
        "typescript": "^5.9.2",
        "vue": "^3.5.44",
        "vue-router": "^4.5.0"
    },
    "devDependencies": {
        "@types/jsdom": "^21.1.7",
        "@types/node": "^24.19.2",
        "@vitejs/plugin-vue": "^6.0.10",
        "@vue/test-utils": "^2.5.1",
        "@vue/tsconfig": "^0.9.1",
        "happy-dom": "^20.7.0",
        "jsdom": "^26.0.0",
        "prettier": "3.9.10",
        "sass-embedded": "^1.105.2",
        "typescript": "~5.9.2",
        "unplugin-auto-import": "^19.2.0",
        "vite": "^7.3.7",
        "vite-plugin-vue-devtools": "^8.2.1",
        "vitest": "^3.2.7",
        "vue-tsc": "^2.2.10"
    }
}
